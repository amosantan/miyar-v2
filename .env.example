# ============================================================================
# Miyar V2 - Environment Variables
# ============================================================================

# Runtime profile and database
# `local` is the safe default. Set MIYAR_RUNTIME_PROFILE only in the invoking
# process or deployment configuration; safety controls are intentionally not loaded from .env.
# Local/test database examples must be loopback or another disposable target; never paste a shared URL here.
DATABASE_URL="mysql://miyar_local:local-password@127.0.0.1:3306/miyar_local"

# Only guarded database-integration commands use this separate disposable target.
# Ordinary `pnpm test` must remain database-free and must not fall back to either URL.
TEST_DATABASE_URL="mysql://miyar_test:test-password@127.0.0.1:3306/miyar_test"

# Do not add MIYAR_RUNTIME_PROFILE, MIYAR_DATABASE_APPROVAL, or
# MIYAR_DEPLOYMENT_DATABASE_TARGET to this file.
# A remote/shared database requires named human authorization and a one-command binding
# supplied outside `.env`; a managed preview target additionally requires infrastructure approval.

# Auth - JWT secret for session tokens (required)
JWT_SECRET="your-secret-key-here"

# AI / LLM - Google Gemini (required for AI features)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"  # optional, defaults to gemini-2.5-flash

# Voice Transcription (optional — required for voice features)
OPENAI_API_KEY="your-openai-api-key"

# Storage - AWS S3 (optional — used for file/image uploads)
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_S3_BUCKET="your-bucket-name"
AWS_REGION="us-east-1"

# Email Notifications (optional — used for owner alerts)
RESEND_API_KEY="your-resend-api-key"

# Google Maps (optional — used for geocoding & location features)
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Server
PORT=3000
NODE_ENV=development

# Background ingestion, learning, and alert workers remain off for local/test/preview work.
# Do not set ENABLE_BACKGROUND_JOBS here. It is an explicit, approved isolated-workflow opt-in.
