{
    "version": 2,
    "functions": {
        "api/**": {
            "maxDuration": 300
        }
    },
    "crons": [
        {
            "path": "/api/cron/ingestion",
            "schedule": "0 6 * * 1"
        }
    ],
    "headers": [
        {
            "source": "/api/trpc/design.resolveShareLink",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "private, no-store"
                },
                {
                    "key": "Pragma",
                    "value": "no-cache"
                },
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex, nofollow, noarchive"
                }
            ]
        },
        {
            "source": "/share/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "private, no-store"
                },
                {
                    "key": "Pragma",
                    "value": "no-cache"
                },
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex, nofollow, noarchive"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
